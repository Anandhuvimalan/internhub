DATABASE_URL="postgresql://postgres@localhost:5432/internhub?schema=internship"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
APP_URL="http://localhost:3000"

# Header set by YOUR reverse proxy carrying the real client IP (used for rate limits).
# Behind Cloudflare: "cf-connecting-ip". Behind nginx: "x-real-ip". Never use x-forwarded-for.
TRUSTED_IP_HEADER="x-real-ip"
# Extra origins (comma-separated, e.g. a CDN hostname) allowed to call mutations / server actions.
ALLOWED_ORIGINS=""

# Optional — email (worker logs to console when unset)
SMTP_URL=""
EMAIL_FROM="InternHub <no-reply@example.com>"
EMAIL_PER_MINUTE=60

# Optional — private file storage (Cloudflare R2 / any S3-compatible)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# Optional — Mux signed video playback
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""

REVIEW_SLA_HOURS=48
MEETING_REMINDER_MINUTES="1440,60"
