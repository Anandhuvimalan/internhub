# PostgreSQL used by Prisma. For Supabase, copy Connect > Session pooler (port 5432),
# URL-encode the database password, and keep schema=internship and sslmode=require.
# Supabase example (replace every placeholder):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=internship&sslmode=require"
# Supabase API keys are not used by this application.
DATABASE_URL="postgresql://postgres@localhost:5432/internhub?schema=internship"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
APP_URL="http://localhost:3000"

# Optional noninteractive first-admin setup; omit to use `npm run db:bootstrap` prompts.
# BOOTSTRAP_ADMIN_EMAIL="owner@example.com"
# BOOTSTRAP_ADMIN_NAME="Project owner"
# BOOTSTRAP_ADMIN_PASSWORD=""
# Tests only: isolated PostgreSQL database; its name must contain "test".
# TEST_DATABASE_URL="postgresql://postgres@localhost:5432/internhub_test?schema=internship"
# PSQL_BIN="psql"

# Header set by YOUR reverse proxy carrying the real client IP (used for rate limits).
# Behind Cloudflare: "cf-connecting-ip". Behind nginx: "x-real-ip". Never use x-forwarded-for.
TRUSTED_IP_HEADER="x-real-ip"
# Extra origins (comma-separated, e.g. a CDN hostname) allowed to call mutations / server actions.
ALLOWED_ORIGINS=""

# Optional — email (worker logs to console when unset)
SMTP_URL=""
EMAIL_FROM="InternHub <no-reply@example.com>"
EMAIL_PER_MINUTE=60

# Optional — private file storage (Cloudflare R2 / any S3-compatible)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# Optional — Mux signed video playback
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""

REVIEW_SLA_HOURS=48
MEETING_REMINDER_MINUTES="1440,60"

# Required for admin MFA. Generate separately from SESSION_SECRET, keep in secret settings.
# 32 random bytes encoded as 64 hex characters; back up securely (needed to decrypt MFA).
MFA_ENCRYPTION_KEY=
# Private ClamAV daemon. Unavailable scanner => files stay blocked; worker retries.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Scanner definitions checked before every scan (integer 1–30; default 7 days).
CLAMAV_MAX_SIGNATURE_AGE_DAYS=7
